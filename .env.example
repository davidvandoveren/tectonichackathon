# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# Password for the synthetic demo personas (emma, jan, marie). Min. 8 characters.
DEMO_PASSWORD=

# development | test | production
APP_ENV=development
# Plain http on localhost needs this off; Cloud Run (https) keeps the default (true).
COOKIE_SECURE=false
# One-click login as a persona without password (demo only, synthetic data).
PASSWORDLESS_LOGIN=false

# --- Kate assistant -------------------------------------------------------------------
# auto = Gemini as soon as GEMINI_API_KEY is set, else canned demo answers | mock | gemini
KATE_LLM_PROVIDER=auto
# Gemini API key (Google AI Studio or a GCP API key with the Generative Language API enabled)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ElevenLabs: voice (text-to-speech) and speech recognition (Scribe). Both off when the key is empty.
ELEVENLABS_API_KEY=
# Two voices: the default follows the customer's registered gender, the customer can always switch.
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=
# Optional single fallback voice when the two above are empty.
ELEVENLABS_VOICE_ID=
# Usernames allowed to use the demo-only admin endpoints (time machine). Comma separated.
# Empty (the default) means the endpoints answer 404 for everyone.
ADMIN_USERNAMES=
